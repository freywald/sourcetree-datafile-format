	local prefix="${3:-}"
	local postfix="${4:-}"
	local formatter="${5:-echo}"
	local concatenation_string="${6-" · "}"

	[[ -z "$concatenation_string" ]] && concatenation_string=" $__forbidden_text_processing_marker1 "

