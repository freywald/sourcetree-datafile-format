function get_values()
{
	local key="$1"
	local entry_name="$2"
	local is_multiple_value="${3:-true}"

	if [[ ! "$key" =~ ^[0-9]+$ ]]; then
		local indices_as_string="${source_to_indices[$key]:-}"
		[[ -z "$indices_as_string" ]] && { return 0; }
		local -a indices=($indices_as_string)

		if ! $is_multiple_value; then
			if (( ${#indices[@]} > 1 )); then
				echo "Error: duplicate entries exist for source '$key'/'$entry_name'. Cannot return single value." >&2
				return 1
			fi
		fi
		key=${indices[0]}
	fi

	local position="${metadata_positions[$key]:-}"
	local start="${position%%":"*}"
	local length="${position#*":"}"
	local found=false
	local last=""
	if (( length > 0 )); then
		local i
		for ((i=0; i<length; i++)); do
			local metadata_value="${sources_metadata[start + i]}"
			local is_data="${metadata_value%%:*}"
			if ! $is_data; then
				continue
			fi

			local value="${metadata_value#*:}"
			local key="${value%%"="*}"
			value="${value#*"="}"

			if [[ "$key" == "" || "$key" == "$value" ]]; then
				continue
			fi

			if [[ "$key" == "$entry_name" ]]; then
				if ! $is_multiple_value && $found; then
					echo "Error: duplicate kv-pair for key '$entry_name'. Cannot return single value, last value='$last' next value '$value'." >&2
					return 1
				fi

				echo "$value"
				found=true
				last="$value"
			fi
		done
	fi

	#! $found && return 1 #@todo
	#return 0
}

function get_duplicate_values()
{
	local entry_key="$1"
	local entry_name="$2"

	local indices_as_string="${source_to_indices[$entry_key]:-}"
	[[ -z "$indices_as_string" ]] && return 1
	local -a indices=($indices_as_string)

	local index
	for index in "${indices[@]}"; do
		local position="${metadata_positions[$index]:-}"
		local start="${position%%":"*}"
		local length="${position#*":"}"
		if (( length > 0 )); then
			local i
			for ((i=0; i<length; i++)); do
				local metadata_value="${sources_metadata[start + i]}"
				local is_data="${metadata_value%%:*}"
				if ! $is_data; then
					continue
				fi
				local value="${metadata_value#*:}"
				local k="${value%%"="*}"
				value="${value#*"="}"
				if [[ "$k" == "" || "$k" == "$value" ]]; then
					continue
				fi
				if [[ "$k" == "$entry_name" ]]; then
					echo "$value"
				fi
			done
		fi
	done
}

