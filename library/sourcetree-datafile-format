sluggify() {
	local input="$1"
	local left right

	if [[ "$input" == *"※"* ]]; then
		left="${input%%※*}"
		right="${input#*※}"
		if [[ "$input" == *"※"*"※"* || -z "$left" || -z "$right" ]]; then
			echo "$input"
			return
		fi
		if [[ "$right" =~ ^https?:// ]]; then
			right="$(_sluggify_url "$right")"
		else
			right="$(_sluggify_text "$right")"
		fi
		echo "${left}※${right}"
		return
	fi

	if [[ "$input" =~ ^https?:// ]]; then
		_sluggify_url "$input"
	else
		_sluggify_text "$input"
	fi
}

_sluggify_url() {
	local url="$1"

	# Remove protocol
	local without_protocol="${url#*://}"

	# Extract host and the rest
	local host="${without_protocol%%/*}"
	local rest="${without_protocol#*/}"

	# Remove www. from host
	host="${host#www.}"

	# If no path exists, just return the cleaned host
	if [[ -z "$rest" || "$rest" == "$without_protocol" ]]; then
