get_padding() {
	local string="$1"
	local limit="${2:-20}"

	local string_length="${#string}"
	local padding="$(( limit - string_length ))"

	if (( padding < 2 )); then
		padding=2
	fi

	printf '%*s' "$padding" ""
}

_is_strict_slug() {
	local string="$1"

	[[ -n "$string" ]] || return 1
	[[ "$string" == "${string^^}" ]] || return 1
	[[ "$string" != *" "* ]] || return 1
	[[ "$string" =~ ^[æÄÖÜäöüßẞa-zA-Z0-9./–—-]+$ ]] || return 1

	if [[ "$string" != "-" ]]; then
